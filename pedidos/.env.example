# Copiar a .env en el servidor (chmod 600). Nunca subir .env al repo.
PANEL_PASSWORD=cambiar-esta-clave
# openssl rand -hex 32
SESSION_SECRET=
# Dejar en 0 hasta lanzar: la carta no aparece en Google. Al lanzar: INDEXAR=1
INDEXAR=0

# --- Pago con tarjeta en línea (lib/pagos.mjs). El dinero va a la cuenta del LOCAL, no a 8vobit. ---
# Cifra las credenciales de Flow / Mercado Pago que cada dueño pega en el panel (AES-256-GCM).
# openssl rand -hex 32. Si se cambia o se pierde, las credenciales guardadas dejan de leerse
# (cada local las vuelve a pegar). No es la misma que SESSION_SECRET.
PAGOS_CLAVE=
# Dirección pública (https) para armar la vuelta del cliente y el aviso de la pasarela (webhook).
PAGOS_URL_BASE=https://pedidos.8vobit.xyz
# Cobros reales: vacío o 0 = solo modo de prueba (sandbox), aunque un local elija "Cobros reales".
PAGOS_PRODUCCION=0
# Opcionales (valores por defecto ya puestos en el código):
# FLOW_API_URL_SANDBOX=https://sandbox.flow.cl/api
# FLOW_API_URL_PRODUCCION=https://www.flow.cl/api
# MP_API_URL=https://api.mercadopago.com
