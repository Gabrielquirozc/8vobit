# Copiar a /srv/docker/compose/n8n/.env en el servidor y completar. Nunca subir el .env real.

# Clave de cifrado de credenciales de n8n. Generar en el servidor: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# --- Instagram (app de Meta, "Instagram API with Instagram Login") ---
# Token que tú inventas y pegas igual en el panel de Meta al configurar el webhook. Generar: openssl rand -hex 24
IG_VERIFY_TOKEN=
# "App secret" de la app de Meta (Configuración > Básica). Sirve para verificar que los avisos vienen de Meta.
IG_APP_SECRET=
# Token de acceso de larga duración de la cuenta @8vobit (dura 60 días; hay que renovarlo).
IG_ACCESS_TOKEN=

# --- Aviso al celular por ntfy (ya corre en el servidor) ---
NTFY_URL=http://100.124.178.118:8090/8vobit-dm

# --- Enlaces que se mandan en las respuestas ---
LINK_AGENDA=https://calendly.com/8vobit/agendar
LINK_PEDIDOS=https://8vobit.xyz/pedidos/
LINK_WEB=https://8vobit.xyz/
